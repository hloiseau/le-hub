{
  "name": "le-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "test": "playwright test",
    "generate:api": "openapi-typescript api/openapi.json -o app/types/generated.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- app/types/generated.d.ts"
  },
  "dependencies": {
    "nuxt": "4.6.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
  }
}
